{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liquidity-arena-backup-scheduler",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "37 * * * *",
      "57 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "CLOUDFLARE_GITHUB_TOKEN"
    ]
  }
}
