# GenLayer browser integration. V8 on Bradbury is the sole deployment. The
# generic and V8 contract values are deliberately both required and must match.
VITE_GENLAYER_NETWORK=testnet-bradbury
VITE_GENLAYER_ACTIVE_DEPLOYMENT=v8
VITE_GENLAYER_PROTOCOL=LIQUIDITY_ARENA_V8
VITE_GENLAYER_CONTRACT=0x06b643f94003e51c6dc47e89524e7fd045630549
VITE_GENLAYER_V8_CONTRACT=0x06b643f94003e51c6dc47e89524e7fd045630549
# The production server and loopback development expose /genlayer-rpc on the
# app origin automatically. Set this only when the wallet RPC is hosted on a
# different HTTPS origin.
VITE_GENLAYER_WALLET_RPC=
# Bradbury is a non-gasless testnet. Its test GEN has no production value, but
# the connected recipient still pays Bradbury transaction fees.
# Required by `npm start`; kept server-side and never included in the bundle.
GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
# Server-only V8 readiness expectations. These are public addresses/amounts,
# not signing secrets.
GENLAYER_V8_OWNER=0x797d3b25fb2cca0ff93f60df1910267f3822d655
GENLAYER_V8_KEEPER=0x797d3b25fb2cca0ff93f60df1910267f3822d655
GENLAYER_V8_TREASURY=0x87e94edab4418e8a9ea37c0fab0675cf0602a9f2
GENLAYER_V8_PAYOUT_FACTORY=0xc812709d267372ad7e06807bf0a4d451ed263a30
GENLAYER_V8_MIN_STAKE_ATTO=100000000000000000
GENLAYER_V8_MAX_STAKE_PER_WALLET_ATTO=10000000000000000000
GENLAYER_V8_MIN_AVAILABLE_RESERVE_ATTO=600000000000000000

# Provisioned by the Vercel Neon integration; never expose it to the browser.
DATABASE_URL=
# A random server/history-sync-job shared secret for bounded canonical history sync.
# Scope the hosted value to Vercel Production and the GitHub Bradbury V8 keeper
# environment; Preview and Development do not need it.
HISTORY_INGEST_SECRET=

# Authoritative keeper transaction journal. The URL and random secret are used
# only by the GitHub keeper job; the same secret is configured server-side in
# Vercel Production. The signer address is public and is compared canonically.
KEEPER_JOURNAL_URL=https://liquidity-arena.vercel.app/api/keeper-journal
KEEPER_JOURNAL_SECRET=
KEEPER_JOURNAL_SIGNER_ADDRESS=0x797d3b25fb2cca0ff93f60df1910267f3822d655

# Production HTTP runtime. Run `npm run build` before `npm start`.
HOST=0.0.0.0
PORT=4400
DIST_DIR=dist
SHUTDOWN_GRACE_MS=5000
# Limit long-lived live-price streams per resolved client while retaining the
# separate 100-connection process-wide cap.
SSE_MAX_CLIENTS_PER_IP=4
# Leave blank when clients connect directly. Behind a reverse proxy, list only
# the proxy's exact socket IP address(es); forwarding headers are ignored unless
# the direct peer matches this allowlist. The proxy must append or replace
# X-Forwarded-For, never pass an untrusted value through unchanged.
TRUSTED_PROXY_ADDRESSES=

# Public Binance Spot data needs no key. It drives the immediate visualization
# estimate. Monetary results come only from the active contract's immutable
# five-exchange policy (Binance, OKX, Bybit, Gate, and KuCoin; at least 3 qualify).
# If your network cannot reach Binance Vision, the proxy automatically tries
# the two official fallbacks below. You can override the order with a
# comma-separated subset of Binance's documented Spot REST v3 hosts. This is
# server-side only and intentionally rejects arbitrary URLs.
# BINANCE_REST_BASES=https://data-api.binance.vision/api/v3,https://api.binance.com/api/v3,https://api-gcp.binance.com/api/v3
