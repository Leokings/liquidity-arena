{
  "name": "liquidity-arena",
  "version": "1.0.0",
  "private": true,
  "description": "Liquidity Arena — a circular crypto-market dominance visualization with prediction settlement on GenLayer.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host --port 4400 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4400 --strictPort",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test market/*.test.mjs api/*.test.mjs history/*.test.mjs ops/bradbury-v8/*.test.mjs scripts/genlayer-command.test.mjs scripts/history-sync.test.mjs scripts/ops-watchdog.test.mjs scripts/v8-keeper-config.test.mjs scripts/v8-keeper.test.mjs scripts/v8-workflow.test.mjs server/*.test.mjs",
    "test:market": "node --test market/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=github,list",
    "keeper:check": "node scripts/v8-keeper.mjs --config scripts/examples/v8-keeper.example.json",
    "keeper:v8:check": "node scripts/v8-keeper.mjs --config scripts/examples/v8-keeper.example.json",
    "keeper:v8:run": "node scripts/v8-keeper.mjs --config scripts/examples/v8-keeper.example.json --execute",
    "history:sync": "node scripts/history-sync.mjs",
    "test:v8:bradbury": "node --test ops/bradbury-v8/*.test.mjs",
    "v8:bradbury:status": "node ops/bradbury-v8/harness.mjs status",
    "v8:bradbury:deploy": "node ops/bradbury-v8/harness.mjs deploy",
    "v8:bradbury:fund": "node ops/bradbury-v8/harness.mjs fund",
    "v8:bradbury:activate": "node ops/bradbury-v8/harness.mjs activate",
    "v8:bradbury:resume": "node ops/bradbury-v8/harness.mjs resume",
    "v8:bradbury:reconcile": "node ops/bradbury-v8/harness.mjs reconcile"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "ethers": "6.17.0",
    "genlayer": "0.39.2",
    "keytar": "7.9.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@noble/hashes": "2.3.0",
    "genlayer-js": "1.1.8",
    "ws": "^7.5.13"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "dockerode@4.0.12": {
      "uuid": "11.1.1"
    }
  }
}
